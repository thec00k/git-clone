# Telegram (user session — create at https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=trader_session
# Comma-separated group IDs or @usernames
TELEGRAM_GROUP_IDS=-1001234567890,@some_alpha_group

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
WALLET_PRIVATE_KEY=
# Set to true to simulate trades without broadcasting
PAPER_TRADING=true

# Optional enrichment APIs
HELIUS_API_KEY=
BIRDEYE_API_KEY=

# Portfolio targets (USD)
PORTFOLIO_PHASE_TWO_USD=300
PORTFOLIO_TARGET_USD=1000
MAX_BUY_USD=20
MIN_BUY_USD=10
TARGET_AVG_BUY_USD=15

# Exits
TAKE_PROFIT_PCT=50
DUST_RETENTION_PCT=10
STOP_LOSS_PCT=35

# Risk gates — skip buys when score exceeds threshold (0-100)
MAX_RISK_SCORE=85
