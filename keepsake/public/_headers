# Security and caching headers. Read by Cloudflare Pages and Netlify (same format);
# any other host needs the equivalent configured. See docs/security-headers.md.
#
# The Content-Security-Policy is REPORT-ONLY for now: browsers log what it would
# block without blocking anything. Tighten and switch it to enforcing once a
# real hosted build has been exercised (Spotify, SoundCloud, scan import).

/*
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://sdk.scdn.co https://open.spotify.com https://w.soundcloud.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.scdn.co https://*.sndcdn.com; media-src 'self' data: blob:; font-src 'self'; connect-src 'self' data: blob: https://api.spotify.com https://accounts.spotify.com https://open.spotify.com http://127.0.0.1:* http://localhost:*; frame-src https://open.spotify.com https://w.soundcloud.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
