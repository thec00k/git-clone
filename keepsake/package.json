{
  "name": "keepsake",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "assets:doctor": "node scripts/refresh-room-assets.mjs --doctor",
    "assets:refresh": "node scripts/refresh-room-assets.mjs",
    "check:assets:browser": "node scripts/check-room-assets-browser.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:storage": "node scripts/check-storage-browser.mjs",
    "check:room": "node scripts/check-woodland.mjs",
    "check:acceptance": "node scripts/check-acceptance.mjs",
    "check:editor": "node scripts/check-editor.mjs",
    "check:memories": "node scripts/check-memory-features.mjs",
    "check:discoveries": "node scripts/check-discoveries.mjs && node scripts/check-discovery-geometry.mjs",
    "check:workbench": "node scripts/check-workbench.mjs && node scripts/check-furniture.mjs",
    "check:workbench:browser": "node scripts/check-workbench-browser.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
