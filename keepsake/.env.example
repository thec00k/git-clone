# Spotify Developer app — Client ID only (public, used by PKCE in the browser).
# Do not put SPOTIFY_CLIENT_SECRET here. The secret must never reach the frontend.
#
# In the Spotify dashboard, register Redirect URIs:
#   http://127.0.0.1:5174/
#   http://localhost:5174/
# plus your production origin when you have one.

VITE_SPOTIFY_CLIENT_ID=
# Optional override; defaults to the page origin + "/"
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5174/
